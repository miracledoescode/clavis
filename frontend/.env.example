# Clavis frontend (Next.js) — PUBLIC config only.
# Every NEXT_PUBLIC_* value is exposed to the browser. NEVER put the Supabase
# service-role key or any provider secret here — those live in backend/.env.
# Copy this file to .env.local and fill in the values.

# Supabase (browser uses the ANON key only; RLS scopes every row to the user).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI engine base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
