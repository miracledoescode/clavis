# Clavis backend (FastAPI engine) — secrets. Copy to .env and fill in.
# NEVER commit a real .env. The browser/frontend uses ONLY the Supabase anon key;
# every value below is engine-only (service-role key + provider secrets).

# --- Supabase (Postgres + Auth + Realtime) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# For verifying the Supabase JWT (RS256 via JWKS, or the legacy HS256 secret).
SUPABASE_JWT_SECRET=

# --- MetaApi (MT5 execution + MetaStats trader profile) ---
METAAPI_TOKEN=

# --- Claude / Anthropic (Agent reasoning + strategy NLP) ---
ANTHROPIC_API_KEY=
# Default model is claude-sonnet-4-6 (see app/config.py); override only if needed.
CLAUDE_MODEL=claude-sonnet-4-6

# --- Dodo Payments (Merchant of Record; Standard Webhooks) ---
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=

# --- Telegram (Agent proposals: Approve/Reject + alerts) ---
# Telegram's protocol name for the token issued by @BotFather (external constant).
TELEGRAM_BOT_TOKEN=

# --- Upstash Redis (cache, queues, rate counters) ---
UPSTASH_REDIS_URL=

# --- API / CORS (optional; default http://localhost:3000) ---
CORS_ALLOW_ORIGINS=http://localhost:3000
